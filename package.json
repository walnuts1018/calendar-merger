{
  "name": "calendar-merger",
  "version": "0.1.0",
  "private": true,
  "description": "Google Calendarの表示を拡張するローカルChrome拡張機能",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build",
    "dev": "wxt",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint .",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "zip": "wxt zip"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "happy-dom": "20.14.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.2"
}
